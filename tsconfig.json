{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "module": "ES2022",
    "lib": [
      "ES2022",
      "DOM"
    ],
    "skipLibCheck": true,
    "outDir": "./dist",
    "paths": {
      "@/*": [
        "./lib/*"
      ]
    },
    "moduleResolution": "bundler",
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "allowJs": true,
    "checkJs": true,
    "declaration": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedSideEffectImports": true,
    "noImplicitAny": true,
    "types": ["node"]
  },
  "include": [
    "lib",
    "./index.ts",
    "test",
    "scripts"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}