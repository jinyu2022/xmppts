{
  "name": "xmppjs",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "files": [
    "dist/",
    "index.d.ts",
    "index.js"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./lib/*": {
      "import": "./dist/lib/*",
      "types": "./dist/lib/*"
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsc --noEmit && tsdown",
    "ts-check": "tsc --noEmit",
    "test": "vitest"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/events": "^3.0.3",
    "@types/node": "^25.9.1",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "hsluv": "^1.0.1",
    "loglevel": "^1.9.2"
  },
  "optionalDependencies": {
    "events": "^3.3.0",
    "image-size": "^2.0.4",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  }
}
