{
  "name": "xmppts",
  "version": "0.1.0",
  "description": "基于 TypeScript 的 XMPP 协议库，支持 Node.js 与浏览器环境，扩展协议以插件形式实现",
  "license": "MPL-2.0",
  "type": "module",
  "files": [
    "dist/"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lib/*": {
      "types": "./dist/lib/*.d.ts",
      "import": "./dist/lib/*.js"
    }
  },
  "scripts": {
    "dev": "tsdown --watch",
    "build": "tsc --noEmit && tsdown && node scripts/check-dts-augmentation.mjs",
    "check:dts": "node scripts/check-dts-augmentation.mjs",
    "ts-check": "tsc --noEmit",
    "test": "vitest",
    "prepublishOnly": "npm run build"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "tsdown": "^0.23.2",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "hsluv": "^1.0.1",
    "loglevel": "^1.9.2"
  },
  "optionalDependencies": {
    "image-size": "^2.0.4",
    "ws": "^8.18.0"
  },
  "engines": {
    "node": ">=20"
  }
}
