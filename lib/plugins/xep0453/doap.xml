    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0054.html"/>
        <xmpp:status>complete</xmpp:status>
        <xmpp:note xml:lang="en">Historical XEP; provides vCard-temp types and parse/build helpers only.</xmpp:note>
        <xmpp:note xml:lang="zh">历史遗留规范；仅提供 vCard-temp 类型与解析/构造工具方法。</xmpp:note>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0060.html"/>
        <xmpp:status>partial</xmpp:status>
        <xmpp:note xml:lang="en">Builds request IQs for the subscriber, publisher and owner use cases and parses event notifications and error conditions; it does not maintain node or subscription state.</xmpp:note>
        <xmpp:note xml:lang="zh">为订阅者、发布者与所有者用例构造请求 IQ，并解析事件通知与错误条件；不维护节点与订阅状态。</xmpp:note>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0077.html"/>
        <xmpp:status>partial</xmpp:status>
        <xmpp:note xml:lang="en">Only the in-band registration flow (section 3.1); account cancellation and password change are not implemented.</xmpp:note>
        <xmpp:note xml:lang="zh">仅实现带内注册流程（§3.1）；未实现注销账号与修改密码。</xmpp:note>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0082.html"/>
