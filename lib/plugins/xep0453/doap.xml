        <xmpp:status>partial</xmpp:status>
        <xmpp:note xml:lang="en">Provides vCard avatar helpers for MUC; no presence parser is registered.</xmpp:note>
        <xmpp:note xml:lang="zh">提供供 MUC 使用的 vCard 头像工具方法；未注册 presence 解析器。</xmpp:note>
      </xmpp:SupportedXep>
    </implements>
    <implements>
