        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0115.html"/>
        <xmpp:status>partial</xmpp:status>
        <xmpp:note xml:lang="en">Generates and parses capability elements; caching of other entities' capabilities and disco#info verification are not implemented.</xmpp:note>
        <xmpp:note xml:lang="zh">生成并解析能力元素；未实现其他实体的能力缓存与 disco#info 校验。</xmpp:note>
      </xmpp:SupportedXep>
    </implements>
    <implements>
      <xmpp:SupportedXep>
        <xmpp:xep rdf:resource="https://xmpp.org/extensions/xep-0128.html"/>
