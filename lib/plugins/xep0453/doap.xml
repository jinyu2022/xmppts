        <xmpp:status>partial</xmpp:status>
        <xmpp:note xml:lang="en">Parses PEP event notifications; server PEP capability probing is not performed.</xmpp:note>
        <xmpp:note xml:lang="zh">解析 PEP 事件通知；不探测服务器的 PEP 能力。</xmpp:note>
      </xmpp:SupportedXep>
