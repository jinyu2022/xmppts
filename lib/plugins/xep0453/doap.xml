<?xml version="1.0" encoding="UTF-8"?>
<rdf:RDF xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
         xmlns="http://usefulinc.com/ns/doap#"
         xmlns:xmpp="https://linkmauve.fr/ns/xmpp-doap#">
  <Project>
    <name>xmppts</name>
    <created>2024-12-09</created>

    <shortdesc xml:lang="en">TypeScript XMPP library for Node.js and browsers</shortdesc>
    <shortdesc xml:lang="zh">基于 TypeScript 的 XMPP 协议库，支持 Node.js 与浏览器</shortdesc>

    <description xml:lang="en">A TypeScript implementation of the XMPP protocol for Node.js and browsers, with extensions implemented as plugins. Supports TCP with STARTTLS, direct TLS and WebSocket transports, SASL authentication, resource binding, stream management and a large set of XEP plugins.</description>
    <description xml:lang="zh">基于 TypeScript 的 XMPP 协议库，目标环境为 Node.js 与浏览器，扩展协议以插件形式实现。支持 TCP + STARTTLS、直连 TLS 与 WebSocket 传输，SASL 认证、资源绑定、流管理以及大量 XEP 插件。</description>

    <homepage rdf:resource="https://github.com/jinyu2022/xmppjs"/>
    <bug-database rdf:resource="https://github.com/jinyu2022/xmppjs/issues"/>

    <license rdf:resource="https://github.com/jinyu2022/xmppjs/blob/master/LICENSE"/>

    <language>en</language>
    <language>zh</language>

    <programming-language>TypeScript</programming-language>

    <os>Linux</os>
    <os>macOS</os>
    <os>Windows</os>
    <os>Browser</os>

    <category rdf:resource="https://linkmauve.fr/ns/xmpp-doap#category-library"/>

    <repository>
      <GitRepository>
        <browse rdf:resource="https://github.com/jinyu2022/xmppjs"/>
        <location rdf:resource="https://github.com/jinyu2022/xmppjs.git"/>
      </GitRepository>
    </repository>

    <implements rdf:resource="https://xmpp.org/rfcs/rfc6120.html"/>
